APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile — bot protection for the email-code entry add-on.
# Create a widget at dash.cloudflare.com (Turnstile). Both keys must be set for
# the token to be enforced server-side; leave blank to ship the add-on with the
# code flow only (no bot protection).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Default sender for verification emails (must be on a Resend-verified domain).
# Per-site custom domains override this later; this is only the default.
VERIFICATION_FROM_ADDRESS="verify@micrositesinminutes.com"
VERIFICATION_FROM_NAME="Microsites in Minutes"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pay-to-publish. Leave PAYWALL off until Stripe test mode is verified end to
# end; with it off, publishing is unchanged and no site is asked to pay. Use
# TEST keys only — nothing real is charged (see config/services.php).
PAYWALL=false
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Optional: email to notify on new leads (requires a real mailer; Cloud mail is log by default).
LEAD_NOTIFY_EMAIL=

# Launch promotion: when true, every build is free (no cost accrues) and the UI
# shows a "free while in beta" banner. Turn off once real billing is wired.
LAUNCH_FREE=false

# MCP connector (Grok/Tesla). APP_URL must be https in production for OAuth.
# Generate Passport keys per environment on deploy: php artisan passport:keys
# (or set PASSPORT_PRIVATE_KEY / PASSPORT_PUBLIC_KEY env vars so they persist).

# Comma-separated emails allowed into the /admin webmaster dashboard (must be verified accounts).
WEBMASTER_EMAILS=
